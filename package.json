{
  "name": "streamweave",
  "version": "0.2.0",
  "description": "StreamWeaver - local-only Node automation server with a browser control UI",
  "author": "StreamWeaver Team",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env WS_PORT=8090 npx dotenv-cli -e .env -- tsx server.ts",
    "dev:dashboard": "cross-env DASHBOARD_MODE=true concurrently \"npm:dev:next\" \"npm:dev:ws\"",
    "dev:next": "cross-env PORT=3100 NEXT_PUBLIC_STREAMWEAVE_PORT=3100 npx next dev -p 3100 -H 127.0.0.1",
    "dev:ws": "cross-env WS_PORT=8090 npx tsx server.ts",
    "build": "npm run lint && npm run typecheck && npx next build",
    "build:simple": "npx next build",
    "flow-library:sync": "npx tsx scripts/sync-flow-library.ts",
    "flow-packages:verify": "npx tsx scripts/verify-flow-packages.ts",
    "flow-packages:smoke": "npx tsx scripts/smoke-flow-package-tooling.ts",
    "persistence:verify": "node --import tsx scripts/verify-automation-variable-persistence.ts",
    "test:isolation": "node --import tsx --test --test-force-exit tests/*.test.ts && npm run persistence:verify",
    "social-stream:bridge": "npx tsx scripts/social-stream-bridge.ts",
    "social-stream:supervisor": "npx tsx scripts/social-stream-supervisor.ts",
    "migrate:discord-config": "npx tsx scripts/migrate-discord-config-single-source.ts",
    "disable:discord-log-mirror-history": "npx tsx scripts/disable-discord-log-mirror-history.ts",
    "start": "cross-env NODE_ENV=production npx dotenv-cli -e .env -- tsx scripts/start-local.ts",
    "lint": "npx next lint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --incremental false",
    "health-check": "node health-check.js",
    "setup": "npm run health-check",
    "postinstall": "npx patch-package && node scripts/bootstrap-runtime.js",
    "streamweaver:simple": "cross-env WS_PORT=8090 npx tsx server.ts",
    "start:local": "cross-env NODE_ENV=production WS_PORT=8090 PORT=3100 NEXT_PUBLIC_STREAMWEAVE_PORT=3100 npx dotenv-cli -e .env -- tsx scripts/start-local.ts",
    "package:release": "npx tsx scripts/package-local-release.ts source",
    "package:companion-runtime": "cross-env NEXT_DIST_DIR=.next-release npm run build:simple && npx tsx scripts/stage-companion-runtime.ts",
    "smoke:companion-runtime": "node scripts/smoke-companion-runtime.mjs",
    "package:win": "npm run package:companion-runtime && npm --prefix companion run dist:win",
    "package:mac": "npm run build:simple && npx pkg . --targets node20-macos-x64 --output dist/bin/StreamWeaver && npx tsx scripts/package-local-release.ts mac",
    "package:linux": "npm run build:simple && npx pkg . --targets node20-linux-x64 --output dist/bin/StreamWeaver && npx tsx scripts/package-local-release.ts linux",
    "companion:start": "npm --prefix companion start",
    "companion:check": "npm --prefix companion run check"
  },
  "dependencies": {
    "@emnapi/runtime": "^1.7.0",
    "@google-cloud/speech": "7.5.0",
    "@google-cloud/text-to-speech": "6.4.1",
    "@google/genai": "^2.12.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@spmt/sdk": "https://spmt.live/sdk/spmt-sdk-0.1.4.tgz",
    "@types/pako": "^2.0.4",
    "@types/wav": "^1.0.4",
    "ansi_up": "^6.0.0",
    "axios": "1.18.1",
    "buffer": "^6.0.3",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cowsay": "^1.6.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "figlet": "^1.10.0",
    "form-data": "4.0.6",
    "framer-motion": "^11.5.7",
    "googleapis": "^168.0.0",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.22",
    "next-auth": "4.24.15",
    "obs-websocket-js": "^5.0.7",
    "pako": "^2.1.0",
    "process": "^0.11.10",
    "pusher-js": "^8.4.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tiktok-live-connector": "2.4.3",
    "tmi.js": "^1.8.5",
    "tsx": "^4.11.0",
    "utf-8-validate": "^6.0.6",
    "wav": "^1.0.2",
    "ws": "8.21.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^20.19.29",
    "@types/react": "18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.3.3",
    "patch-package": "^8.0.0",
    "pkg": "^5.8.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  },
  "pkg": {
    "scripts": [
      "server.ts",
      "scripts/start-local.ts",
      "src/**/*.ts",
      "src/**/*.tsx"
    ],
    "assets": [
      "public/**/*",
      ".next/**/*",
      "app-urls.json",
      "config/**/*",
      "data/**/*",
      "tokens/**/*",
      "README-LOCAL-APP.md"
    ],
    "outputPath": "dist"
  }
}
