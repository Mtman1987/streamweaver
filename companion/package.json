{
  "name": "@spmt/companion",
  "version": "0.3.2",
  "private": true,
  "description": "SpaceMountain tray companion for overlays, OBS, audio, media, and local execution",
  "author": "Mtman1987",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "prestart": "node ../scripts/patch-companion-presence-always-on-top.mjs",
    "start": "electron .",
    "precheck": "node ../scripts/patch-companion-presence-always-on-top.mjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check overlay-preload.cjs && node --check lib/config-store.cjs && node --check lib/diagnostics-store.cjs && node --check lib/media-jobs.cjs && node --check lib/relay-client.cjs && node --check lib/spmt-surfaces.cjs && node --check lib/tenant-bootstrap.cjs && node --check lib/update-manager.cjs && node --check lib/workflow-jobs.cjs && node --check ui/renderer.js && node --test test/*.test.cjs",
    "predist:win": "node ../scripts/patch-companion-presence-always-on-top.mjs",
    "dist:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "live.spmt.companion",
    "productName": "SpaceMountain Companion",
    "artifactName": "SpaceMountain-Companion-Setup.${ext}",
    "copyright": "Copyright © 2026 Mtman1987",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "../dist/companion"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "overlay-preload.cjs",
      "lib/**/*",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/companion-runtime",
        "to": "runtime",
        "filter": ["**/*", "!node_modules/**/*", "!smoke.*.log"]
      },
      {
        "from": "../dist/companion-runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../public/app-icon.png",
        "to": "assets/app-icon.png"
      }
    ],
    "win": { "icon": "../public/favicon.ico", "target": ["nsis"] },
    "protocols": [
      {
        "name": "SPMT Companion",
        "schemes": ["spmt-companion"]
      }
    ],
    "publish": [{ "provider": "github", "owner": "Mtman1987", "repo": "streamweaver", "releaseType": "release" }],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpaceMountain Companion"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "obs-websocket-js": "^5.0.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  }
}
